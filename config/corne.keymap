#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        BASE_LAYER {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "BASE";
            bindings = <
&kp ESCAPE    &kp Q  &kp W  &kp E  &kp R           &kp T        &kp Y      &kp U          &kp I      &kp O    &kp P     &kp RCTRL
&kp TAB       &kp A  &kp S  &kp D  &kp F           &kp G        &kp H      &kp J          &kp K      &kp L    &kp SEMI  &kp SQT
&kp LEFT_GUI  &kp Z  &kp X  &kp C  &kp V           &kp B        &kp N      &kp M          &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_ALT
                            &mo 1  &kp LEFT_SHIFT  &kp ENTER    &kp SPACE  &kp BACKSPACE  &mo 2
            >;
        };

        SYMNUM_LAYER {
            display-name = "SYMNUM";
            bindings = <
&kp ESCAPE    &kp EXCL  &kp AT        &kp HASH      &kp DLLR        &kp PRCNT       &kp CARET       &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp BACKSLASH
&kp TAB       &kp N0    &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3    &kp NUMBER_4    &kp MINUS       &kp EQUAL      &kp GRAVE     &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp PIPE
&kp LEFT_GUI  &kp N5    &kp NUMBER_6  &kp N7        &kp N8          &kp N9          &kp UNDERSCORE  &kp PLUS       &kp TILDE     &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp RIGHT_ALT
                                      &trans        &kp LEFT_SHIFT  &kp ENTER       &kp SPACE       &kp BACKSPACE  &trans
            >;
        };

        FUNC_LAYER {
            display-name = "FUNC";
            bindings = <
&kp F1      &kp F2        &kp F2        &kp F4            &kp F5        &kp F6             &kp F7    &kp F8        &kp F9     &kp F10  &kp F11  &kp F12
&none       &kp K_PREV    &kp K_NEXT    &kp K_PLAY_PAUSE  &kp C_VOL_DN  &kp C_VOLUME_UP    &none     &kp UP_ARROW  &none      &none    &to 0    &to 1
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2      &bt BT_SEL 3  &bt BT_SEL 4       &kp LEFT  &kp DOWN      &kp RIGHT  &none    &to 2    &to 3
                                        &trans            &trans        &kp ENTER          &trans    &trans        &trans
            >;
        };

        GAME_LAYER {
            bindings = <
&kp ESCAPE  &kp NUMBER_1    &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5       &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans          &kp Q         &kp W         &kp E         &kp R        &trans  &trans  &trans  &trans  &to 0   &to 1
&trans      &kp LEFT_SHIFT  &kp A         &kp S         &kp D         &kp F        &trans  &trans  &trans  &trans  &to 2   &trans
                                          &trans        &kp LCTRL     &kp SPACE    &trans  &trans  &trans
            >;

            label = "GAME";
        };
    };
};
